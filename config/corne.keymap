#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "balanced";
            require-prior-idle-ms = <130>;
        };

        td_tab: td_tab {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_TAB";
            #binding-cells = <0>;
            bindings = <&kp TAB>, <&kp CAPS>;
        };

        ht_keypad: ht_keypad {
            compatible = "zmk,behavior-tap-dance";
            label = "HT_KEYPAD";
            #binding-cells = <0>;
            bindings = <&mo 4>, <&tog 4>;
        };

        ht_mouse_3: ht_mouse_3 {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_MOUSE_3";
            bindings = <&mo>, <&tog>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-trigger-key-positions = <37>;
        };

        td_quest: td_quest {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_QUEST";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QUESTION>;

            tapping-term-ms = <100>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp ESCAPE  &kp Q  &kp W  &kp E            &kp R            &kp T              &kp Y            &kp U              &kp I            &kp O    &kp P                   &kp BSPC
&td_tab     &kp A  &kp S  &hm LS(LCTRL) D  &hm LSHFT F      &hm LCTRL G        &hm RIGHT_GUI H  &hm RIGHT_SHIFT J  &hm RIGHT_ALT K  &kp L    &mt DOUBLE_QUOTES APOS  &kp ENTER
&kp PG_UP   &kp Z  &kp X  &kp C            &kp V            &kp B              &td_quest        &kp N              &kp M            &kp DOT  &kp FSLH                &kp PAGE_DOWN
                          &kp LGUI         &ht_mouse_3 3 3  &lt 2 BACKSPACE    &lt 1 SPACE      &ht_keypad         &tog 2
            >;
        };

        Num {
            display-name = "Num";
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans   &kp N1         &kp N2            &kp N3         &kp N4     &kp N5        &kp N6     &kp N7     &kp N8            &kp N9             &kp N0  &kp BSPC
&kp TAB  &kp BACKSLASH  &kp SINGLE_QUOTE  &kp SEMICOLON  &kp COMMA  &kp PERIOD    &kp MINUS  &kp EQUAL  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans  &kp SLASH
&trans   &trans         &trans            &trans         &trans     &trans        &trans     &trans     &trans            &trans             &trans  &trans
                                          &kp LGUI       &trans     &kp SPACE     &kp RET    &trans     &trans
            >;
        };

        BT {
            display-name = "BT";
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  |  |  |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TILDE   &kp EXCL      &kp AT        &kp HASH      &kp DLLR      &kp PRCNT         &kp CARET          &kp AMPS  &kp ASTRK     &kp LPAR   &kp RPAR  &kp BSPC
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &out OUT_USB      &kp C_VOLUME_UP    &trans    &kp UP_ARROW  &trans     &trans    &trans
&kp LSHFT   &trans        &trans        &trans        &trans        &studio_unlock    &kp C_VOLUME_DOWN  &kp LEFT  &kp DOWN      &kp RIGHT  &trans    &trans
                                        &trans        &trans        &trans            &trans             &trans    &trans
            >;
        };

        Mouse {
            display-name = "Mous";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &kp C_AC_BACK   &kp C_AC_REFRESH  &kp C_AC_FORWARD  &kp C_AC_HOME    &kp PRINTSCREEN  &trans
&none   &none   &none   &none   &none   &none     &msc SCRL_UP    &mkp LCLK         &mmv MOVE_UP      &mkp RCLK        &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans    &msc SCRL_DOWN  &mmv MOVE_LEFT    &mmv MOVE_DOWN    &mmv MOVE_RIGHT  &msc SCRL_LEFT   &msc SCRL_RIGHT
                        &trans  &trans  &trans    &trans          &trans            &trans
            >;
        };

        FN {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6     &kp KP_PLUS      &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_SUBTRACT  &trans
&kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12    &kp KP_MULTIPLY  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_DIVIDE    &trans
&trans  &trans  &trans  &trans   &trans   &trans     &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_DOT       &kp KP_NUMLOCK
                        &trans   &trans   &trans     &kp EQUAL        &trans           &trans
            >;
        };
    };
};
